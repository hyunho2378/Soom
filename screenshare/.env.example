# 이 파일을 .env로 복사해 값을 채운다. .env는 커밋하지 않는다(.gitignore에 있음).
# Render에서는 대시보드 환경변수에 같은 키로 넣는다.

# Neon 연결 문자열. Neon 대시보드의 Connection string(psql/Node.js)을 그대로 붙인다.
# 끝에 ?sslmode=require가 붙어 있어야 한다.
# 참고: 지금 pg 버전은 require를 verify-full과 같게 다루면서 부팅 때 경고를 한 줄 찍는다.
# Neon 인증서는 공개 신뢰 체인이라 그대로 검증에 통과한다. 경고를 없애려면 require를 verify-full로 바꿔 적으면 된다.
DATABASE_URL=

# 세션 서명용 긴 랜덤 문자열. 아래 명령으로 만든다.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Google Cloud Console > 사용자 인증 정보 > OAuth 클라이언트 ID(웹 애플리케이션)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 승인된 리디렉션 URI에 등록한 값과 글자 하나까지 같아야 한다.
# 로컬:  http://localhost:3000/auth/google/callback
# Render: https://앱이름.onrender.com/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Vercel 대시보드 > Storage > Blob Store에서 발급한 읽기 쓰기 토큰
BLOB_READ_WRITE_TOKEN=

# 강연자를 특정 메일로만 제한하고 싶을 때 콤마로 구분해 넣는다.
# 비워두면 구글 로그인한 사람이 곧 강연자다(지금 약속).
ADMIN_EMAILS=

# Render 대시보드에만 production 으로 등록한다. 로컬에는 넣지 마라.
# 이 값이 production이면 세션 쿠키에 secure가 켜지는데, 로컬은 http라 켜면 로그인이 안 붙는다.
NODE_ENV=

# 로컬은 3000. Render는 자기가 주입하므로 Render 대시보드에는 등록하지 마라.
PORT=3000
